# A database name here is IGNORED - it comes from NODE_ENV.
MONGODB_URI=mongodb://127.0.0.1:27017

# Required. Picks the database: vihaanx-dev / vihaanx / vihaanx-test.
NODE_ENV=development

PORT=4000

# Comma-separated, no trailing slash, no wildcard. Empty allows no origin.
CORS_ORIGINS=http://localhost:3000

# Proxy hops to trust, not a boolean: 0 locally, 1 behind Render/Railway.
TRUST_PROXY=0

# Both required, >= 32 chars, and must differ. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-with-a-development-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-development-secret-32-chars

ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=2d

# Read-only access to public repositories is enough.
GITHUB_TOKEN=replace-with-a-github-token

CLOUDINARY_URL=cloudinary://local-key:local-secret@local-cloud

# All required, ISO 8601 with an offset. These are local development defaults;
# the real event schedule is set on the host, never from this file.
EVENT_START=2026-11-14T09:00:00+05:30
PROJECT_OPEN=2026-11-14T10:00:00+05:30
PROJECT_CLOSE=2026-11-14T10:30:00+05:30
CHECKPOINT_1_OPEN=2026-11-14T11:00:00+05:30
CHECKPOINT_1_CLOSE=2026-11-14T12:30:00+05:30
CHECKPOINT_2_OPEN=2026-11-14T13:00:00+05:30
CHECKPOINT_2_CLOSE=2026-11-14T14:30:00+05:30
CHECKPOINT_3_OPEN=2026-11-14T15:00:00+05:30
CHECKPOINT_3_CLOSE=2026-11-14T16:30:00+05:30
CHECKPOINT_4_OPEN=2026-11-14T17:00:00+05:30
CHECKPOINT_4_CLOSE=2026-11-14T18:30:00+05:30
