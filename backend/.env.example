# A database name here is IGNORED - it comes from NODE_ENV.
MONGODB_URI=mongodb://127.0.0.1:27017

# development (default) | production | test. Also picks the database above.
NODE_ENV=development

# Port the API listens on.
PORT=4000

CORS_ORIGINS=http://localhost:3000

# Proxy hops to trust for the real client IP. A count, not a boolean: 0 locally,
# 1 behind Render/Railway.
TRUST_PROXY=0

# Both required, >= 32 chars, and must differ. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-with-a-development-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-development-secret-32-chars

ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=2d

# Read-only access to public repositories is enough (5,000 requests/hour).
GITHUB_TOKEN=replace-with-a-github-token

CLOUDINARY_URL=cloudinary://local-key:local-secret@local-cloud

# Event schedule. These values are local development defaults; replace them
# with the actual event schedule when testing event-window behavior.
EVENT_START=2026-11-14T09:00:00+05:30
PROJECT_OPEN=2026-11-14T10:00:00+05:30
PROJECT_CLOSE=2026-11-14T18:00:00+05:30
CHECKPOINT_1_OPEN=2026-11-14T11:00:00+05:30
CHECKPOINT_1_CLOSE=2026-11-14T12:00:00+05:30
CHECKPOINT_2_OPEN=2026-11-14T13:00:00+05:30
CHECKPOINT_2_CLOSE=2026-11-14T14:00:00+05:30
CHECKPOINT_3_OPEN=2026-11-14T15:00:00+05:30
CHECKPOINT_3_CLOSE=2026-11-14T16:00:00+05:30
CHECKPOINT_4_OPEN=2026-11-14T17:00:00+05:30
CHECKPOINT_4_CLOSE=2026-11-14T18:00:00+05:30


