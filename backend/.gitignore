# Dependencies
node_modules/
.npm/

# Build output
dist/
*.tsbuildinfo
.tsup/

# Secrets. .env.example is the template and IS committed.
.env
.env.*
!.env.example

# Participant data.
*.csv
*.tsv

# Test fixtures are invented data and ARE committed - the integration tests
# cannot run on a fresh clone without them.
!tests/fixtures/*.csv
dump/
dumps/
backups/
exports/
*.bson
*.archive
*.mongodump



# Printable RSVP / QR card codes (scripts/generateQrCodes, Open #3)
qr-codes/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test and coverage output (none yet; added when a feature needs tests)
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Editors. Shared Prettier/extension settings may be committed deliberately.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.pid
